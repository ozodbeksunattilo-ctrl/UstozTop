{
  "name": "ustoztop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p server/tsconfig.json",
    "lint": "oxlint",
    "preview": "vite preview",
    "server:dev": "tsx watch server/src/index.ts",
    "server:typecheck": "tsc -p server/tsconfig.json --noEmit",
    "db:meta": "tsx server/scripts/gen-meta.ts",
    "test": "vitest run --config server/vitest.config.ts"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "marked": "^18.1.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
